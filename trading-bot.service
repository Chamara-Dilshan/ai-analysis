# Install on the VM (once):
#   sudo cp ~/trading-analysis/trading-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now trading-bot
# Logs:  journalctl -u trading-bot -n 50
[Unit]
Description=Telegram command bot for the trading monitor
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/home/ubuntu/trading-analysis/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
